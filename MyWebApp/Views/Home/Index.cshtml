@model MyWebApp.Models.HomeViewModel
@{ViewData["Title"]="Cafe & Studio";}
<section class="hero"><p class="eyebrow">CAFE & STUDIO</p><h1>กาแฟดี ๆ กับช่วงเวลาพิเศษของคุณ</h1><p>สั่งอาหารที่โต๊ะ หรือจองคิวช่างภาพและช่างแต่งหน้าได้ในที่เดียว</p><div class="actions"><a class="button" href="/booking">จองคิวสตูดิโอ</a><a class="button secondary" href="#menu">ดูเมนู</a></div></section>
<div class="content">
    @if(Model.Error is not null){<p class="notice">@Model.Error</p>}
    <section class="showcase"><div><p class="eyebrow">STUDIO TEAM</p><h2>ช่างผู้เชี่ยวชาญ</h2><p>ดูผลงานและเลือกบริการที่เหมาะกับช่วงเวลาพิเศษของคุณ</p><a href="/booking" class="text-link">ดูคิวและจองบริการ →</a></div><div class="cards">@foreach(var artist in Model.Artists){<article class="card"><span class="tag">Studio Artist</span><h3>@artist.FullName</h3><p>@artist.Bio</p>@if(artist.Specialties.Length>0){<small>ถนัด: @string.Join(" · ",artist.Specialties)</small>}@if(!string.IsNullOrWhiteSpace(artist.PortfolioUrl)){<p><a href="@artist.PortfolioUrl" target="_blank" rel="noreferrer">ดูผลงาน</a></p>}</article>}</div></section>
    <section id="menu"><div class="section-heading"><div><p class="eyebrow">CAFE MENU</p><h2>เมนูแนะนำ</h2></div></div><div class="cards">@foreach(var item in Model.Menu){<article class="card"><span class="tag">@item.Category</span><h3>@item.Name</h3><p>@item.Price.ToString("N2") บาท</p></article>}</div></section>
    <section class="services"><p class="eyebrow">STUDIO SERVICES</p><h2>บริการสตูดิโอ</h2><div class="cards">@foreach(var service in Model.Services){<article class="card"><h3>@service.Name</h3><p>@service.Price.ToString("N2") บาท</p><a class="text-link" href="/booking">เลือกคิว →</a></article>}</div></section>
</div>
