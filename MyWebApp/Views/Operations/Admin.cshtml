@model AdminViewModel
@{ViewData["Title"]="จัดการร้าน";var total=(Model.Overview?.PaidToday??0);var cafePercent=total==0?0:(double)((Model.Overview?.CafeRevenue??0)/total*100);var studioPercent=100-cafePercent;}
<section class="content admin-page"><p class="eyebrow">CAFE & STUDIO · MANAGEMENT</p><h1>จัดการร้าน</h1>
@if(TempData["Success"] is string success){<p class="success">@success</p>}@if(TempData["Error"] is string error){<p class="notice">@error</p>}
@if(Model.Overview is not null){<div class="cards kpis"><article class="card"><span>ยอดขายวันนี้</span><strong>@Model.Overview.PaidToday.ToString("N2") ฿</strong></article><article class="card"><span>จองวันนี้</span><strong>@Model.Overview.BookingsToday</strong></article><article class="card"><span>โต๊ะกำลังใช้</span><strong>@Model.Overview.OpenTables</strong></article><article class="card"><span>รายการจองรอชำระ</span><strong>@Model.Overview.PendingBookings</strong></article></div>
<section class="card"><h2>สัดส่วนรายได้วันนี้</h2><div class="revenue-split"><div><span>☕ Cafe</span><strong>@Model.Overview.CafeRevenue.ToString("N2") บาท</strong></div><div><span>📸 Studio</span><strong>@Model.Overview.StudioRevenue.ToString("N2") บาท</strong></div></div><div class="split-bar"><span style="width:@cafePercent.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)%"></span><span style="width:@studioPercent.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)%"></span></div></section>}
<h2>คิวสตูดิโอที่รอชำระ</h2><div class="cards">@foreach(var b in Model.Bookings.Where(x=>x.Status=="Pending")){<article class="card"><span class="tag">รอชำระ</span><h3>@b.CustomerName · @b.ServiceName</h3><p>@b.StaffName · @b.BookingDate.ToString("dd/MM/yyyy") · @b.TimeSlot</p><strong>@b.TotalPrice.ToString("N2") บาท</strong><form asp-action="BookingPaid" asp-route-id="@b.Id" method="post" class="inline-form"><select name="method"><option value="CASH">เงินสด</option><option value="PROMPTPAY">PromptPay</option></select><button class="button small">ยืนยันรับชำระ</button></form></article>}</div>
<section class="card admin-editor"><h2>จัดการเมนู</h2><form asp-action="MenuCreate" method="post" class="form-row"><input name="Name" placeholder="ชื่อเมนู" required/><input name="Category" placeholder="หมวดหมู่" value="เครื่องดื่ม" required/><input name="Price" type="number" min="0" step="0.01" placeholder="ราคา" required/><button class="button">เพิ่มเมนู</button></form><div class="table-scroll"><table><thead><tr><th>เมนู</th><th>หมวด</th><th>ราคา</th><th>พร้อมขาย</th><th></th></tr></thead><tbody>@foreach(var item in Model.Menu){<tr><td colspan="5"><form asp-action="MenuUpdate" method="post" class="form-row table-form"><input type="hidden" name="Id" value="@item.Id"/><input name="Name" value="@item.Name" required/><input name="Category" value="@item.Category" required/><input name="Price" type="number" min="0" step="0.01" value="@item.Price"/><label class="check-inline"><input name="IsAvailable" type="checkbox" value="true" checked="@item.IsAvailable"/> พร้อมขาย</label><input name="IsAvailable" type="hidden" value="false"/><button class="button small">บันทึก</button></form></td></tr>}</tbody></table></div></section>
<section class="card admin-editor"><h2>จัดการบริการสตูดิโอ</h2><form asp-action="ServiceCreate" method="post" class="form-row"><input name="Name" placeholder="ชื่อบริการ" required/><input name="Price" type="number" min="0" step="0.01" placeholder="ราคา" required/><button class="button">เพิ่มบริการ</button></form><div class="cards">@foreach(var service in Model.Services){<form asp-action="ServiceUpdate" method="post" class="form-row card service-edit"><input type="hidden" name="Id" value="@service.Id"/><input name="Name" value="@service.Name" required/><input name="Price" type="number" min="0" step="0.01" value="@service.Price"/><button class="button small">บันทึก</button></form>}</div></section>
@if(Context.Session.GetString("Cafe.Role")=="Owner"){<section class="card admin-editor"><h2>บัญชีผู้ใช้และสิทธิ์พนักงาน</h2><div class="cards">@foreach(var user in Model.Staff){<form asp-action="UpdateRole" method="post" class="staff-row"><input type="hidden" name="Id" value="@user.Id"/><strong>@user.FullName</strong><small>@user.Email · @user.Role</small><select name="Role"><option selected="@(user.Role=="Member")">Member</option><option selected="@(user.Role=="Artist")">Artist</option><option selected="@(user.Role=="Waiter")">Waiter</option><option selected="@(user.Role=="Kitchen")">Kitchen</option><option selected="@(user.Role=="Cashier")">Cashier</option><option selected="@(user.Role=="Manager")">Manager</option><option selected="@(user.Role=="Owner")">Owner</option><option selected="@(user.Role=="IT Staff")">IT Staff</option></select><input name="Bio" placeholder="ประวัติช่าง (ถ้ามี)"/><input name="PortfolioUrl" placeholder="ลิงก์ผลงาน (ถ้ามี)"/><button class="button small">บันทึกสิทธิ์</button></form>}</div></section>}
</section>
