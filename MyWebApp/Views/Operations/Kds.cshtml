@model KdsViewModel
@{ViewData["Title"]="หน้าจอครัว";}
<section class="content"><p class="eyebrow">KITCHEN DISPLAY SYSTEM</p><h1>หน้าจอครัว</h1><div class="toolbar"><a class="button @(Model.Summary?"secondary":"")" href="/kds">คิวตามเวลา</a><a class="button @(Model.Summary?"":"secondary")" href="/kds?summary=true">รวมเมนู</a><a class="button secondary" href="/kds">รีเฟรช</a></div>
@if(Model.Summary){<div class="cards">@foreach(var item in Model.SummaryItems){<article class="card"><span class="tag">สรุปรวม</span><h3>@item.Menu × @item.Quantity</h3><p>รวมรายการที่ยังไม่เสิร์ฟ</p></article>}</div>if(Model.SummaryItems.Count==0){<p class="card">ไม่มีรายการที่รอทำ</p>}}
else{<div class="cards">@foreach(var item in Model.Items){<article class="card"><span class="tag">โต๊ะ @item.Table · @item.KdsStatus</span><h3>@item.Menu × @item.Quantity</h3>@if(!string.IsNullOrWhiteSpace(item.Note)){<p>หมายเหตุ: @item.Note</p>}<p>@item.CreatedAt.ToLocalTime().ToString("HH:mm")</p>@if(item.KdsStatus=="Pending"){<form asp-action="KitchenStatus" asp-route-id="@item.Id" method="post"><input type="hidden" name="status" value="Cooking"/><button class="button">เริ่มทำ</button></form>}else if(item.KdsStatus=="Cooking"){<form asp-action="KitchenStatus" asp-route-id="@item.Id" method="post"><input type="hidden" name="status" value="Served"/><button class="button">เสิร์ฟแล้ว</button></form>}</article>}</div>if(Model.Items.Count==0){<p class="card">ยังไม่มีรายการจากโต๊ะ</p>}}
</section><script>window.setTimeout(()=>window.location.reload(),10000);</script>
