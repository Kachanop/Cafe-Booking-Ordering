@model CashierViewModel
@{ViewData["Title"]="แคชเชียร์";}
<section class="content"><p class="eyebrow">CASHIER</p><h1>แคชเชียร์</h1>
@if(TempData["Success"] is string success){<p class="success">@success</p>}@if(TempData["Error"] is string error){<p class="notice">@error</p>}@if(ViewBag.Error is string apiError){<p class="notice">@apiError</p>}
<h2>โต๊ะที่เรียกเก็บเงิน</h2>@if(Model.Bills.Count==0){<p class="card">ยังไม่มีโต๊ะเรียกเก็บเงิน</p>}<div class="cards">@foreach(var row in Model.Bills){<article class="card"><span class="tag">@row.TableNumber · เรียกเก็บเงิน</span><h3>บิล #@row.OrderId</h3>@foreach(var item in row.Items){<p>@item.Menu × @item.Quantity · @((item.Price*item.Quantity).ToString("N2")) บาท</p>}<h3>รวม @row.TotalAmount.ToString("N2") บาท</h3><form asp-action="CloseTable" method="post"><input type="hidden" name="tableId" value="@row.TableId"/><label>รับชำระ<select name="method"><option value="CASH">เงินสด</option><option value="PROMPTPAY">PromptPay ที่หน้าร้าน</option></select></label><button class="button">ยืนยันรับชำระและปิดโต๊ะ</button></form></article>}</div>
<h2 class="section-spaced">คิวสตูดิโอที่รอชำระ</h2><div class="cards">@foreach(var booking in Model.PendingBookings){<article class="card"><span class="tag">รอชำระ</span><h3>@booking.CustomerName · @booking.ServiceName</h3><p>@booking.StaffName · @booking.BookingDate.ToString("dd/MM/yyyy") · @booking.TimeSlot</p><strong>@booking.TotalPrice.ToString("N2") บาท</strong><form asp-action="BookingPaid" asp-route-id="@booking.Id" method="post"><label>ช่องทางชำระ<select name="method"><option value="CASH">เงินสด</option><option value="PROMPTPAY">PromptPay</option></select></label><button class="button">ยืนยันรับชำระ</button></form></article>}</div>
</section><script>window.setTimeout(()=>window.location.reload(),10000);</script>
